<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#020509" />
      <stop offset="50%" stop-color="#091220" />
      <stop offset="100%" stop-color="#050c14" />
    </linearGradient>
    <linearGradient id="brand" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#22d3ee" />
      <stop offset="100%" stop-color="#2563eb" />
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)" />
  <circle cx="900" cy="150" r="300" fill="#22d3ee" opacity="0.03" filter="blur(80px)" />
  <circle cx="200" cy="500" r="250" fill="#2563eb" opacity="0.04" filter="blur(60px)" />
  <g transform="translate(100, 220)">
    <rect width="80" height="80" rx="20" fill="url(#brand)" opacity="0.9" />
    <path d="M40 20 L58 45 A15 15 0 1 1 22 45 Z" fill="white" transform="translate(10, 10) scale(0.8)" />
    <text x="110" y="55" font-family="system-ui, sans-serif" font-weight="900" font-size="48" fill="#ffffff" letter-spacing="-1px">QAdvertiser</text>
    <text x="110" y="90" font-family="system-ui, sans-serif" font-weight="600" font-size="18" fill="#22d3ee" letter-spacing="4px">SMART HYDRATION CAMPAIGN</text>
  </g>
</svg>
