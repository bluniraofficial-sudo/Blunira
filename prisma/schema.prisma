datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  advertiserId  String?
  advertiser    Advertiser?    @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  notifications Notification[]
  auditLogs     AuditLog[]
  isDeleted     Boolean        @default(false)
  resetToken    String?
  resetTokenExpiry DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([roleId])
  @@index([advertiserId])
  @@map("users")
}

model Advertiser {
  id          String     @id @default(uuid())
  name        String
  companyName String
  email       String     @unique
  phone       String?
  category    String?
  status      String     @default("ACTIVE") // ACTIVE, SUSPENDED
  users       User[]
  campaigns   Campaign[]
  leads       Lead[]
  coupons     Coupon[]
  orders      Order[]
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([email])
  @@map("advertisers")
}

model Campaign {
  id            String       @id @default(uuid())
  name          String
  description   String?
  status        String       @default("ACTIVE") // ACTIVE, INACTIVE
  advertiserId  String
  advertiser    Advertiser   @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  landingPage   LandingPage?
  qrCodes       QrCode[]
  leads         Lead[]
  coupons       Coupon[]
  bannerUrl     String?
  logoUrl       String?
  videoUrl      String?
  startDate     DateTime?
  endDate       DateTime?
  isDeleted     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([advertiserId])
  @@map("campaigns")
}

model LandingPage {
  id              String    @id @default(uuid())
  campaignId      String    @unique
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title           String
  subtitle        String?
  imageBanner     String?
  offerText       String?
  countdownEnd    DateTime?
  leadFormEnabled Boolean   @default(true)
  whatsappButton  Boolean   @default(false)
  whatsappNumber  String?
  callButton      Boolean   @default(false)
  callNumber      String?
  websiteButton   Boolean   @default(false)
  websiteUrl      String?
  googleMapsUrl   String?
  videoUrl        String?
  termsText       String?
  privacyText     String?
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([campaignId])
  @@map("landing_pages")
}

model QrCode {
  id          String   @id @default(uuid())
  qrCodeId    String   @unique // sequential code e.g. QR000000001
  publicUrl   String // dynamic route redirect path
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bottleBatch String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  scanCount   Int      @default(0)
  lastScan    DateTime?
  scans       QrScan[]
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaignId])
  @@index([qrCodeId])
  @@map("qr_codes")
}

model QrScan {
  id         String   @id @default(uuid())
  qrCodeId   String
  qrCode     QrCode   @relation(fields: [qrCodeId], references: [qrCodeId], onDelete: Cascade)
  ipAddress  String?
  userAgent  String?
  deviceType String?
  os         String?
  browser    String?
  city       String?
  country    String?
  scannedAt  DateTime @default(now())

  @@index([qrCodeId])
  @@index([scannedAt])
  @@map("qr_scans")
}

model Lead {
  id           String             @id @default(uuid())
  name         String
  phone        String
  email        String?
  city         String?
  ipAddress    String?
  userAgent    String?
  consentCheck Boolean            @default(false)
  campaignId   String
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  advertiserId String
  advertiser   Advertiser         @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  redemptions  CouponRedemption[]
  isDeleted    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([campaignId])
  @@index([advertiserId])
  @@map("leads")
}

model Coupon {
  id                 String             @id @default(uuid())
  code               String
  title              String
  description        String?
  discount           String?
  maxRedemptions     Int?
  currentRedemptions Int                @default(0)
  expiryDate         DateTime?
  advertiserId       String
  advertiser         Advertiser         @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaignId         String?
  campaign           Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  redemptions        CouponRedemption[]
  isDeleted          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([advertiserId])
  @@index([campaignId])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  redeemedAt DateTime @default(now())

  @@index([couponId])
  @@index([leadId])
  @@map("coupon_redemptions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model BottleProduct {
  id               String         @id @default(uuid())
  name             String
  description      String?
  capacity         String // e.g., "500ml", "1L"
  moq              Int // Minimum Order Quantity
  bottlesPerPack   Int @default(12) // Number of bottles in one packet
  pricePerUnit     Decimal        @db.Decimal(10, 2)
  pricePerPack     Decimal?       @db.Decimal(10, 2) // Optional: price per packet
  imageUrl         String?
  status           String         @default("ACTIVE") // ACTIVE, INACTIVE
  isDeleted        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  orders           OrderItem[]

  @@map("bottle_products")
}

model Order {
  id               String         @id @default(uuid())
  orderNumber      String         @unique // e.g., ORD-2026-0001
  advertiserId     String
  advertiser       Advertiser     @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  status           String         @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  totalAmount      Decimal        @db.Decimal(10, 2)
  advanceAmount    Decimal        @default(0) @db.Decimal(10, 2) // 50% advance payment
  balanceAmount    Decimal        @default(0) @db.Decimal(10, 2)
  advancePaid      Boolean        @default(false)
  advancePaidAt    DateTime?
  fullPaid         Boolean        @default(false)
  fullPaidAt       DateTime?
  paymentMethod    String? // BANK_TRANSFER, UPI, CARD, CASH
  shippingAddress  String
  shippingCity     String
  shippingState    String
  shippingPincode  String
  billingAddress   String?
  billingCity      String?
  billingState     String?
  billingPincode   String?
  gstNumber        String?
  notes            String?
  deliveryInstructions String?
  handleMissingItems   String? // REPLACE, REFUND, CREDIT_NOTE
  specialHandling      String?
  invoiceUrl       String?
  invoiceNumber    String?
  confirmedAt      DateTime?
  processingAt     DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  dispatchDate     DateTime?
  trackingNumber   String?
  courierName      String?
  deliveryDate     DateTime?
  deliveredBy      String?
  items            OrderItem[]
  payments         Payment[]
  isDeleted        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([advertiserId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         BottleProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int
  pricePerUnit    Decimal        @db.Decimal(10, 2)
  totalPrice      Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(10, 2)
  paymentType     String // ADVANCE, BALANCE
  paymentMethod   String // BANK_TRANSFER, UPI, CARD, CASH
  transactionId   String?
  paymentProof    String? // URL to uploaded payment proof
  status          String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedBy      String?
  verifiedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@map("payments")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique // order_confirmation, payment_reminder, invoice_sent, etc.
  subject     String
  htmlBody    String   @db.Text
  textBody    String?  @db.Text
  variables   String? // JSON array of available variables
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}
